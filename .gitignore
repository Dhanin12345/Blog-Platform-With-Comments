# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
venv/
ENV/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# Node & Frontend
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite / React build cache
.vite/
frontend/dist/
frontend/node_modules/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables
.env
.env.local
.env.*.local

# Databases & Media (keep schema migrations, exclude local runtime db)
backend/db.sqlite3
backend/media/*
!backend/media/.gitkeep

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS Generated
.DS_Store
Thumbs.db
